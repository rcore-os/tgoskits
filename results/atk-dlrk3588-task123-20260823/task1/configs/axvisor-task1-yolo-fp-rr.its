/dts-v1/;

/ {
	description = "AxVisor ATK-DLRK3588 Task 1 FP-RR YOLO A/B (RAM boot)";
	#address-cells = <1>;

	images {
		kernel-1 {
			description = "AxVisor FP-RR with StarryOS YOLO and RT-Thread periodic probe";
			data = /incbin/("/home/huhu/atk-bringup/axvisor-task1-yolo-fp-rr.bin");
			type = "kernel";
			arch = "arm64";
			os = "linux";
			compression = "none";
			load = <0x00400000>;
			entry = <0x00400000>;
			hash-1 { algo = "sha256"; };
		};
		fdt-1 {
			description = "ATK-DLRK3588 host device tree";
			data = /incbin/("/home/huhu/atk-bringup/atk-dlrk3588-starry.dtb");
			type = "flat_dt";
			arch = "arm64";
			compression = "none";
			load = <0x08300000>;
			hash-1 { algo = "sha256"; };
		};
	};

	configurations {
		default = "conf-1";
		conf-1 {
			description = "ATK-DLRK3588 Task 1 FP-RR YOLO RAM boot";
			kernel = "kernel-1";
			fdt = "fdt-1";
		};
	};
};
