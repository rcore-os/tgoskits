{
  "arch": "riscv64",
  "code-model": "medium",
  "cpu": "generic-rv64",
  "crt-objects-fallback": "false",
  "data-layout": "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128",
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "exe-suffix": ".elf",
  "features": "+m,+a,+c,+zicsr,+zifencei",
  "is-like-windows": true,
  "linker": "bootloader/axloader/src/arch/riscv64/linker.py",
  "linker-flavor": "gnu-lld",
  "llvm-abiname": "lp64",
  "llvm-target": "riscv64",
  "max-atomic-width": 64,
  "metadata": {
    "description": "RISC-V UEFI application with an ELF link and embedded PE32+ header",
    "host_tools": false,
    "std": false
  },
  "os": "uefi",
  "panic-strategy": "abort",
  "position-independent-executables": true,
  "pre-link-args": {
    "gnu-lld": ["-pie", "--no-relax"]
  },
  "relocation-model": "pic",
  "target-pointer-width": 64
}
