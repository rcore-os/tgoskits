#!/usr/bin/env python3
"""RUSTC_WRAPPER used by scripts/perf/wakeup-pgo/build.py for profile-use builds.

`build.py` copies this file verbatim into the output directory as `stdlib-wrapper.py`,
grants it the executable bit and points `RUSTC_WRAPPER` at that copy, so the expected
profile path is always resolved next to the run that owns it.

`core`, `alloc`, `compiler_builtins` and `profiler_builtins` come from the precompiled
sysroot and are never instrumented. `ax_task` is intentionally not profiled in the
selective candidate. The other crates keep the flags byte for byte. Each invocation
that targets bare aarch64 is appended to `stdlib-wrapper.jsonl`; `build.py` reads that log
to prove the `starryos` root crate really received `-Cprofile-use=<profile>`.

The wrapper refuses any profile other than the one unpacked into this directory, so a
stale or foreign profdata can never be picked up silently.
"""

import json
import os
import sys
from pathlib import Path

DIRECTORY = Path(__file__).resolve().parent
EXPECTED_PROFILE = DIRECTORY / "profile-use.profdata"
LOG = DIRECTORY / "stdlib-wrapper.jsonl"
UNPROFILED_CRATES = {"core", "alloc", "compiler_builtins", "profiler_builtins", "ax_task"}
PROFILE_USE_FLAG = "-Cprofile-use="
PROFILE_GENERATE_FLAG = "-Cprofile-generate="
PGO_LLVM_ARGS = ("-Cllvm-args=-disable-vp", "-Cllvm-args=-pgo-warn-missing-function")


def flag_value(args, name):
    if name in args:
        return args[args.index(name) + 1]
    return None


def strip_profile_flags(args):
    kept = []
    for argument in args:
        if argument.startswith(PROFILE_USE_FLAG) or argument in PGO_LLVM_ARGS:
            continue
        kept.append(argument)
    return kept


def guard_profile(args):
    for argument in args:
        if argument.startswith(PROFILE_USE_FLAG):
            found = Path(argument.split("=", 1)[1])
            if found != EXPECTED_PROFILE:
                raise SystemExit(
                    f"wakeup-pgo: refusing foreign profdata {found}; expected {EXPECTED_PROFILE}"
                )
        elif argument.startswith(PROFILE_GENERATE_FLAG):
            raise SystemExit("wakeup-pgo: profile-generate is not part of the profile-use build")


def main():
    compiler, *args = sys.argv[1:]
    guard_profile(args)
    crate = flag_value(args, "--crate-name")
    if crate in UNPROFILED_CRATES:
        args = strip_profile_flags(args)
    if crate and crate != "___" and "--target" in args:
        record = {"crate": crate, "target": flag_value(args, "--target"), "args": args}
        with LOG.open("a") as handle:
            handle.write(json.dumps(record) + "\n")
    os.execvp(compiler, [compiler, *args])


if __name__ == "__main__":
    main()
