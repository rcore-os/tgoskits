         let weight = u64::from(self.load_weight());
-        (i128::from(saved_lag).saturating_mul(i128::from(runnable_weight.saturating_add(weight)))
+        let total_weight = runnable_weight.saturating_add(weight);
+        if let (Ok(total_weight), Ok(runnable_weight)) =
+            (i64::try_from(total_weight), i64::try_from(runnable_weight))
