@@ -197,3 +197,26 @@ fn sleep_lag_is_bounded_by_the_linux_rq_max_slice() {
         }
     );
 }
+
+#[test]
+fn placement_lag_fast_path_matches_wide_arithmetic() {
+    let entity = FairEntity::new(Nice::ZERO, FairMode::Normal, 1_000, 0);
+    let weight = u64::from(entity.load_weight());
+    for saved_lag in [i64::MIN, -1_000_000, -1, 0, 1, 1_000_000, i64::MAX] {
+        for runnable_weight in [0, 1, 1_024, i64::MAX as u64, u64::MAX] {
+            let expected = if saved_lag == 0 || runnable_weight == 0 {
+                0
+            } else {
+                (i128::from(saved_lag)
+                    .saturating_mul(i128::from(runnable_weight.saturating_add(weight)))
+                    / i128::from(runnable_weight))
+                .clamp(i128::from(i64::MIN), i128::from(i64::MAX)) as i64
+            };
+            assert_eq!(
+                entity.inflated_placement_lag(saved_lag, runnable_weight),
+                expected,
+                "saved_lag={saved_lag}, runnable_weight={runnable_weight}"
+            );
+        }
+    }
+}
