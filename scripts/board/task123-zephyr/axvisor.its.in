/dts-v1/;

/ {
	description = "AxVisor ATK-DLRK3588 unified Zephyr 4.4.2 Task 1/2/3 @SCHEDULER_LABEL@";
	#address-cells = <1>;

	images {
		kernel-1 {
			description = "AxVisor @SCHEDULER_LABEL@ with StarryOS AI and unified Zephyr 4.4.2";
			data = /incbin/("@AXVISOR_BINARY@");
			type = "kernel";
			arch = "arm64";
			os = "linux";
			compression = "none";
			load = <0x00400000>;
			entry = <0x00400000>;
			hash-1 { algo = "sha256"; };
		};

		fdt-1 {
			description = "ATK-DLRK3588 host device tree";
			data = /incbin/("@HOST_DTB@");
			type = "flat_dt";
			arch = "arm64";
			compression = "none";
			load = <0x08300000>;
			hash-1 { algo = "sha256"; };
		};
	};

	configurations {
		default = "conf-1";
		conf-1 {
			description = "Unified Zephyr 4.4.2 Task 1/2/3 @SCHEDULER_LABEL@ RAM boot";
			kernel = "kernel-1";
			fdt = "fdt-1";
		};
	};
};
