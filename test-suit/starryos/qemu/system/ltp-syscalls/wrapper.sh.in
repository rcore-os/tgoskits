#!/bin/sh
set -eu

case_id="@LTP_CASE_ID@"
minimum_passes=@LTP_MIN_PASSES@
filesystem_passes="@LTP_FILESYSTEM_PASSES@"
ltp_root="/opt/ltp"
version_file="${ltp_root}/Version"
runtest_file="${ltp_root}/runtest/syscalls"
binary_dir="${ltp_root}/testcases/bin"

if [ ! -f "${version_file}" ]; then
    echo "missing LTP version file: ${version_file}" >&2
    exit 2
fi
version="$(tr -d '\r\n' < "${version_file}")"
if [ "${version}" != "20260529" ]; then
    echo "unexpected LTP version: ${version}" >&2
    exit 2
fi
if [ ! -f "${runtest_file}" ]; then
    echo "missing LTP syscall runtest manifest: ${runtest_file}" >&2
    exit 2
fi

if ! command="$(
    awk -v testcase="${case_id}" '
        $1 == testcase {
            matches += 1
            $1 = ""
            sub(/^[[:space:]]+/, "")
            testcase_command = $0
        }
        END {
            if (matches != 1 || testcase_command == "")
                exit 1
            print testcase_command
        }
    ' "${runtest_file}"
)"; then
    echo "missing or duplicate LTP runtest entry: ${case_id}" >&2
    exit 2
fi

set -- ${command}
binary="$1"
if [ ! -x "${binary_dir}/${binary}" ]; then
    echo "missing LTP testcase binary: ${binary_dir}/${binary}" >&2
    exit 2
fi

case_tmp="$(mktemp -d "/tmp/ltp-syscalls-${case_id}.XXXXXX")"
cleanup_case_tmp()
{
    rm -rf -- "${case_tmp}"
}
trap cleanup_case_tmp EXIT HUP INT TERM

export LTPROOT="${ltp_root}"
export PATH="${binary_dir}:${ltp_root}/bin:/usr/sbin:/sbin:/usr/bin:/bin"
export TMPDIR="${case_tmp}"
export LTP_TIMEOUT_MUL=1
case_output="${case_tmp}/ltp-output.log"

set +e
(
    cd "${case_tmp}"
    "$@"
) > "${case_output}" 2>&1
status=$?
set -e
cat "${case_output}"

if [ "${status}" -ne 0 ]; then
    exit "${status}"
fi
if grep -Eq 'T(CONF|BROK|FAIL)[[:space:]]*:' "${case_output}"; then
    echo "LTP testcase reported a non-passing result: ${case_id}" >&2
    exit 1
fi
# Old and new LTP APIs both print TPASS, with different spacing before ':'.
# A zero exit status alone does not prove that the test body completed: a
# wrongly successful exec can replace the child and skip its remaining cases.
passes="$(awk '/(^|[[:space:]])TPASS[[:space:]]*:/ { count++ } END { print count+0 }' "${case_output}")"
if [ "${passes}" -lt "${minimum_passes}" ]; then
    echo "incomplete LTP testcase: ${case_id}: ${passes} TPASS, expected at least ${minimum_passes}" >&2
    exit 1
fi
for contract in ${filesystem_passes}; do
    filesystem="${contract%:*}"
    required="${contract#*:}"
    completed="$(awk -v fs="${filesystem}" '
        /TINFO: === Testing on / { active = ($0 ~ "Testing on " fs " ===") }
        active && /(^|[[:space:]])TPASS[[:space:]]*:/ { count++ }
        END { print count+0 }
    ' "${case_output}")"
    if [ "${completed}" -lt "${required}" ]; then
        echo "incomplete LTP filesystem: ${case_id} ${filesystem}: ${completed} TPASS, expected at least ${required}" >&2
        exit 1
    fi
done
exit 0
