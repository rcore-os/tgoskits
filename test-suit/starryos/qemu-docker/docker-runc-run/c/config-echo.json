{
  "ociVersion": "1.0.2",
  "hostname": "runc-hello",
  "root": {
    "path": "rootfs",
    "readonly": false
  },
  "process": {
    "terminal": false,
    "user": {
      "uid": 0,
      "gid": 0,
      "additionalGids": []
    },
    "args": ["/busybox", "echo", "hello-from-container"],
    "env": ["PATH=/bin:/usr/bin", "OCI_SMOKE=1"],
    "cwd": "/",
    "noNewPrivileges": true,
    "capabilities": {
      "bounding": [],
      "effective": [],
      "inheritable": [],
      "permitted": [],
      "ambient": []
    }
  },
  "rootfsPropagation": "private",
  "linux": {
    "namespaces": [
      { "type": "pid" },
      { "type": "mount" },
      { "type": "uts" },
      { "type": "ipc" }
    ],
    "maskedPaths": [],
    "readonlyPaths": [],
    "resources": {
      "devices": [{ "allow": true, "access": "rwm" }]
    }
  },
  "mounts": [
    {
      "destination": "/proc",
      "type": "proc",
      "source": "proc",
      "options": ["nosuid", "noexec", "nodev"]
    }
  ]
}
