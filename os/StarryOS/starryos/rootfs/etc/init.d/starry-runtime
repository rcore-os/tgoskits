#!/sbin/openrc-run
description="Prepare Starry runtime directories"
depend() {
    provide dev
}
start() {
    ebegin "Preparing Starry runtime"
    mkdir -p /run/udev/data /run/lock /tmp /root || return 1
    touch /run/udev/data/c226:0 /run/udev/data/c29:0 || return 1
    for i in 0 1 2 3 4 5 6 7; do
        touch "/run/udev/data/c13:$((64 + i))" || return 1
    done
    eend 0
}
