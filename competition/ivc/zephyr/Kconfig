mainmenu "Zephyr IVC control endpoint"

source "Kconfig.zephyr"

menu "IVC reliability evidence"

config IVC_DROP_ACK_EVERY
	int "Drop the first ACK for every Nth fresh command"
	range 0 1000000
	default 0
	help
	  Set to zero for the normal endpoint. A positive value enables the
	  deterministic cross-guest ACK-loss profile: the endpoint suppresses the
	  ACK for each Nth freshly applied command, then responds normally when the
	  controller retransmits that command.

config IVC_EXPECTED_COMMANDS
	int "Expected commands in a finite evidence run"
	range 0 1000000
	default 0
	help
	  Set to zero for an open-ended normal endpoint. A positive count emits one
	  terminal IVC-RTOS-RESULT record after all fresh commands are observed. The
	  deterministic ACK-loss profile additionally waits for the expected
	  retransmitted duplicates.

config IVC_EXIT_AFTER_EXPECTED_COMMANDS
	bool "Power off after a finite evidence run"
	depends on IVC_EXPECTED_COMMANDS > 0
	depends on POWEROFF
	default n
	help
	  Power off through PSCI after the terminal IVC-RTOS-RESULT record. Keep
	  this disabled for interactive and open-ended demonstrations. Enable it
	  for automated physical-board runs so AxVisor can regain its shell after
	  every guest has completed.

endmenu
